div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; qp.modify(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; rts_attr,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IBV_QP_STATE &lt;span style=&quot;color: #d4d4d4;&quot;&gt;|&lt;/span&gt; IBV_QP_TIMEOUT &lt;span style=&quot;color: #d4d4d4;&quot;&gt;|&lt;/span&gt; IBV_QP_RETRY_CNT &lt;span style=&quot;color: #d4d4d4;&quot;&gt;|&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IBV_QP_RNR_RETRY &lt;span style=&quot;color: #d4d4d4;&quot;&gt;|&lt;/span&gt; IBV_QP_SQ_PSN &lt;span style=&quot;color: #d4d4d4;&quot;&gt;|&lt;/span&gt; IBV_QP_MAX_QP_RD_ATOMIC&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; )&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; logging.info(&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;QP moved to RTS - connection established!&quot;&lt;/span&gt;)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
