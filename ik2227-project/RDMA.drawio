        <mxCell id="rjWUCo2-bhL27LLFIk7v-6" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;step 3.1&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Creates a RDMA context: A structure representing the opened RDMA device, created during the initalization pthase of RDMA application&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
