        <mxCell id="U6VwuCCli1qXgkCHvHr3-1" value="" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="-90" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="U6VwuCCli1qXgkCHvHr3-2" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;step 5.1&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Server sends its QP number, remote key, buffer address, and GID so the client knwos where to read from&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="130" y="-80" width="490" height="120" as="geometry" />
        </mxCell>
        <mxCell id="U6VwuCCli1qXgkCHvHr3-3" value="" style="shape=flexArrow;endArrow=classic;startArrow=classic;html=1;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry width="100" height="100" relative="1" as="geometry">
            <mxPoint x="278" y="165" as="sourcePoint" />
            <mxPoint x="330" y="30" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="U6VwuCCli1qXgkCHvHr3-4" value="" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
